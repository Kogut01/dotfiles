{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/kogut01.txt",
    "position": "top",
    "color": { "1": "#bd93f9" },
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#bd93f9", "output": "#f8f8f2" },
  },
  "modules": [
    {
      "type": "custom",
      "key": "╭───────────────╮",
      "format": "",
    },
    {
      "type": "title",
      "key": "{#keys}│{##ff79c6}    user      {#keys}│",
      "format": "{user-name}",
    },
    {
      "type": "uptime",
      "key": "{#keys}│{##8be9fd}  󰅐  uptime    {#keys}│",
    },
    {
      "type": "os",
      "key": "{#keys}│{##bd93f9}    distro    {#keys}│",
    },
    {
      "type": "kernel",
      "key": "{#keys}│{##ff79c6}    kernel    {#keys}│",
    },
    {
      "type": "terminal",
      "key": "{#keys}│{##ff5555}    term      {#keys}│",
    },
    {
      "type": "shell",
      "key": "{#keys}│{##50fa7b}    shell     {#keys}│",
    },
    {
      "type": "cpu",
      "key": "{#keys}│{##f1fa8c}  󰍛  cpu       {#keys}│",
      "showPeCoreCount": true,
    },
    {
      "type": "disk",
      "key": "{#keys}│{##8be9fd}  󰉉  disk      {#keys}│",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "memory",
      "key": "{#keys}│{##ff79c6}    memory    {#keys}│",
    },
    {
      "type": "localip",
      "key": "{#keys}│{##50fa7b}  󰩟  network   {#keys}│",
      "format": "{ipv4} ({ifname})",
    },
    {
      "type": "custom",
      "key": "├───────────────┤",
      "format": "",
    },
    {
      "type": "colors",
      "key": "{#keys}│{##f8f8f2}    colors    {#keys}│",
      "symbol": "circle",
    },
    {
      "type": "custom",
      "key": "╰───────────────╯",
      "format": "",
    },
  ],
}

[alias]
	branches = branch -va
	cd = checkout
	ci = commit
	ss = status --short
	lla = log --pretty=format:\"%C(yellow)%h%Creset:%C(red)%d%Creset %s %C(bold magenta)(%cr) [%an]\"
	ll = lla --abbrev-commit -15

[core]
	excludesFile = ~/.config/git/conf/ignore

[init]
	defaultBranch = main

[push]
	default = current
	autoSetupRemote = true
* {
    font: "JetBrains Nerd Font 11";
    bg0: #101010;
    bg1: #181818;
    bg2: #232323;
    fg0: #f5f5f5;
    fg1: #cccccc;
    fg2: #888888;
    accent: #ffffff;
    background-color: transparent;
    padding: 0;
    spacing: 0;
    margin: 0;
}

window {
    location: center;
    width: 450px;
    background-color: @bg0;
    border: 2px;
    border-color: #222222;
    border-radius: 16px;
    padding: 8px;
    children: [ inputbar, listview ];

}

inputbar {
    spacing: 12px;
    padding: 16px 20px;
    children: [ entry, icon-search];
    background-color: @bg0;
}

icon-search {
    expand: false;
    filename: "search-symbolic";
    size: 18px;
    color: @accent;
}

entry {
    placeholder: "Szukaj aplikacji...";
    placeholder-color: @fg2;
    text-color: @accent;
    background-color: @bg2;
    border: 1px;
    border-color: #333333;
    border-radius: 8px;
    padding: 10px 14px;
}

listview {
    lines: 8;
    fixed-height: false;
    scrollbar: true;
    background-color: @bg0;
}

element {
    padding: 14px 14px;
    spacing: 16px;
    background-color: @bg0;
    margin: 0 20px 0 20px;
}

element-text {
    text-color: @fg2;
}

element selected {
    background-color: @accent;
    border-radius: 8px;
}

element-icon {
    size: 28px;
    color: @accent;
}

element selected element-icon {
    color: @bg0;
}

scrollbar {
    width: 4px;
    handle-color: @accent;
    background-color: #333333;
    border-radius: 2px;
    margin: 0 24px 12px 0;
}

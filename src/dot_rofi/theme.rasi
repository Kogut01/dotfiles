* {
    font: "JetBrains Nerd Font 11";
    bg0: #0a0d11;
    bg1: #111823;
    bg2: #1a2332;
    bg3: #243447;
    fg0: #c7b299;
    fg1: #a09184;
    fg2: #6b5d52;
    warm: #e6940a;
    gold: #d4af37;
    moon: #e8dcc6;
    water: #2c5f7c;
    forest: #1e2f1e;
    accent: @warm;
    urgent: @gold;
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

element-icon, element-text, scrollbar {
    cursor: pointer;
}

window {
    location: center;
    width: 420px;
    background-color: @bg1;
    border: 2px;
    border-color: @bg3;
    border-radius: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 12px;
    padding: 12px 16px;
    children: [ icon-search, entry ];
    background-color: @bg0;
    border-radius: 6px 6px 0px 0px;
    border: 0px 0px 1px 0px;
    border-color: @bg3;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

icon-search {
    expand: false;
    filename: "search-symbolic";
    size: 18px;
    color: @warm;
}

entry {
    placeholder: "Szukaj aplikacji...";
    placeholder-color: @fg2;
    text-color: @moon;
}

textbox {
    padding: 8px 12px;
    background-color: @bg2;
    text-color: @fg1;
}

listview {
    padding: 8px 0px;
    lines: 8;
    columns: 1;
    scrollbar: true;
    fixed-height: false;
    dynamic: true;
    background-color: @bg1;
    border-radius: 0px 0px 6px 6px;
}

element {
    padding: 12px 16px;
    spacing: 16px;
    border-radius: 4px;
    margin: 0px 8px 2px 8px;
}

element normal urgent {
    text-color: @urgent;
}

element normal active {
    text-color: @accent;
    background-color: rgba(47, 79, 47, 0.3);
}

element alternate active {
    text-color: @accent;
    background-color: rgba(47, 79, 47, 0.2);
}

element selected {
    text-color: @bg0;
    background-color: @warm;
    border-radius: 6px;
}

element selected urgent {
    background-color: @urgent;
    text-color: @bg0;
}

element selected active {
    background-color: @gold;
    text-color: @bg0;
}

element-icon {
    size: 28px;
}

element-text {
    text-color: inherit;
    font: "JetBrains Nerd Font 11";
}

scrollbar {
    handle-width: 6px;
    handle-color: @warm;
    padding: 0 6px;
    border-radius: 3px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg0;
}

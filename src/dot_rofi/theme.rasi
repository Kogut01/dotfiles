* {
    font: "JetBrains Nerd Font 11";
    bg0: #0e141e;
    bg1: #111823;
    bg2: #1a2332;
    bg3: #243447;
    fg0: #c7b299;
    fg1: #a09184;
    fg2: #6b5d52;
    water: #2c5f7c;
    sky: #5e81ac;
    moon: #e8dcc6;
    forest: #1e2f1e;
    accent: @water;
    urgent: @sky;
    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

element-icon, element-text, scrollbar {
    cursor: pointer;
}

window {
    location: center;
    width: 420px;
    background-color: @bg1;
    border: 2px;
    border-color: @bg3;
    border-radius: 0;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 12px;
    padding: 12px 16px;
    children: [ icon-search, entry ];
    background-color: @bg0;
    border-radius: 0;
    border: 0px 0px 2px 0px;
    border-color: @water;
}

icon-search, entry, element-icon, element-text {
    vertical-align: 0.5;
}

icon-search {
    expand: false;
    filename: "search-symbolic";
    size: 18px;
    color: @water;
}

entry {
    placeholder: "Szukaj aplikacji...";
    placeholder-color: @fg2;
    text-color: @moon;
    border-radius: 0;
}

textbox {
    padding: 8px 12px;
    background-color: @bg2;
    text-color: @fg1;
}

listview {
    padding: 8px 0px;
    lines: 8;
    columns: 1;
    scrollbar: true;
    fixed-height: false;
    dynamic: true;
    background-color: @bg1;
    border-radius: 0;
}

element {
    padding: 12px 16px;
    spacing: 16px;
    border-radius: 0;
    margin: 0px 8px 2px 8px;
}

element normal urgent {
    text-color: @sky;
}

element normal active {
    text-color: @water;
    background-color: rgba(44, 95, 124, 0.3);
}

element alternate active {
    text-color: @water;
    background-color: rgba(44, 95, 124, 0.2);
}

element selected {
    text-color: @bg0;
    background-color: @water;
    border-radius: 0;
}

element selected urgent {
    background-color: @sky;
    text-color: @bg0;
}

element selected active {
    background-color: @sky;
    text-color: @bg0;
}

element-icon {
    size: 28px;
    color: @water;
}

element-text {
    text-color: inherit;
    font: "JetBrains Nerd Font 11";
}

scrollbar {
    handle-width: 6px;
    handle-color: @water;
    padding: 0 6px;
    border-radius: 0;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg0;
}
